{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "strict": true,
    "allowJs": false,
    "sourceMap": true,
    "removeComments": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "scientific_cal/home.ts",
    "scientific_cal/dev_basic/**/*.ts",
    "scientific_cal/src/**/*.ts",
    "scientific_cal/topics/**/*.ts",
    "types/**/*.d.ts"
  ]
}
